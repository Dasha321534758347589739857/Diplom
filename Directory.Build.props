<Project>

  <!-- Общие настройки для всех проектов решения. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Diplom.$(MSBuildProjectName.Replace('Diplom.', ''))</RootNamespace>
  </PropertyGroup>

</Project>
